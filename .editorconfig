root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
# Composable functions are PascalCase by convention, not camelCase.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Flags private backing fields with no same-named public property, even when the backing
# field is legitimately private-only (feeds a `combine()`, never exposed 1:1).
ktlint_standard_backing-property-naming = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
